/* TR3 4 MiB rows, in the same order and format as pools.def.
 * Level: 2040 KiB (2088960 B), matching pools-tr2.def to preserve the
 * 8 KiB cache phase and host sequel budget compatibility.
 * Total: 4026 KiB; reserve: 70 KiB. */
TR64_POOL(image,     608, IMAGE)
TR64_POOL(stack,      64, FIXED)
TR64_POOL(fb,        300, FIXED)
TR64_POOL(zbuf,      150, FIXED)
TR64_POOL(code,       96, CARVE)
TR64_POOL(gpu,       232, CARVE)
TR64_POOL(audio,     128, CARVE)
TR64_POOL(libheap,    64, CARVE)
TR64_POOL(level,    2040, CARVE)
TR64_POOL(state,     296, CARVE)
TR64_POOL(io,         48, CARVE)
