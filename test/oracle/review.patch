+static void coopApplyMedium(Lara* lara,const CoopPose &pose)
+{
+    lara->waterState=pose.water;
+    if (pose.water==WATER_STATE_UNDER)
+        lara->animSet(Lara::ANIM_UNDERWATER,true,0);
+    else if (pose.water==WATER_STATE_SURFACE) {
+        lara->animSet(Lara::ANIM_SURF,true,0);
+        lara->extraL->swimTimer=11;
+    }
+    gCoopPose[lara==players[1]]=pose;
+}
