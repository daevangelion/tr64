+void coopFinishInteraction(Lara* owner)
+{
+    ItemObj*& claim=gCoopInteraction[owner==players[1]];
+    ItemObj* item=claim;
+    if (!item)return;
+    claim=NULL;
+    unsigned status=item->flags&ITEM_FLAG_STATUS;
+    if (status==ITEM_FLAG_STATUS_ACTIVE) {
+        if (item->type>=ITEM_PUZZLEHOLE_1 && item->type<=ITEM_PUZZLEHOLE_4) {
+            item->type=worldPuzzleHoleDoneType(ItemType(item->type),item->flags);
+            return;
+        }
+        if (item->type==ITEM_SWITCH || item->type==ITEM_SWITCH_WATER ||
+            (item->type>=ITEM_BLOCK_1 && item->type<=ITEM_BLOCK_4)) {
+            for (unsigned frame=0;frame<4096;++frame) {
+                item->update();
+                if (!(item->flags&ITEM_FLAG_ACTIVE) ||
+                    (item->flags&ITEM_FLAG_STATUS)!=ITEM_FLAG_STATUS_ACTIVE)return;
+            }
+            ASSERT(false);
+        }
+    }
+    // Authored FX_FINISH_LEVEL in the two Scion interaction animations (hunk 13).
+    if ((item->type==ITEM_SCION_PICKUP_HOLDER && gLevelID==LVL_TR1_10B) ||
+        (item->type==ITEM_SCION_PICKUP_QUALOPEC && gLevelID==LVL_TR1_8C &&
+         (status==ITEM_FLAG_STATUS_INVISIBLE || status==ITEM_FLAG_STATUS_INACTIVE)))
+        completeLevel(owner);
+}
+
+static bool coopGetPose(const Lara* partner,CoopPose &pose)
+{
+    coopRememberPose(partner);
+    pose=gCoopPose[partner==players[1]];
+    return coopPoseUsable(pose);
+}
