+bool coopTriggerBlocked(const ItemObj* item,unsigned type)
+{
+    if (!players[1])return false;
+    for (int i=0;i<MAX_PLAYERS;++i) {
+        if (gCoopInteraction[i]!=item)continue;
+        if (type==TRIGGER_TYPE_SWITCH)
+            return (item->flags&ITEM_FLAG_STATUS)!=ITEM_FLAG_STATUS_INACTIVE;
+        if (type==TRIGGER_TYPE_KEY)
+            return players[i]->extraL->weaponState!=WEAPON_STATE_FREE ||
+                (item->type>=ITEM_PUZZLEHOLE_1 && item->type<=ITEM_PUZZLEHOLE_4);
+    }
+    return false;
+}
+static bool coopPoseUsable(const CoopPose &pose)
+{
+    if (!pose.at.room)return false;
+    if (pose.water!=WATER_STATE_ABOVE && pose.water!=WATER_STATE_WADE)return true;
+    const vec3i p=pose.at.pos;
+    const Sector* s=pose.at.room->getSector(p.x,p.z);
+    const FloorData* trigger=gLastFloorData;
+    const uint16 slant=gLastFloorSlant;
+    const int32 floor=s->getFloor(p.x,p.y,p.z), ceiling=s->getCeiling(p.x,p.y,p.z);
+    gLastFloorData=trigger;
+    gLastFloorSlant=slant;
+    return floor!=WALL && ceiling!=WALL && p.y<=floor && p.y-ceiling>=LARA_HEIGHT;
+}
+void coopRememberPose(const Lara* lara)
+{
+    if (!lara->room || lara->health<=0 || (lara->flags&ITEM_FLAG_GRAVITY))return;
+    switch (lara->state) {
+    case Lara::STATE_STOP: case Lara::STATE_WALK: case Lara::STATE_RUN:
+    case Lara::STATE_TURN_LEFT: case Lara::STATE_TURN_RIGHT: case Lara::STATE_TURN_FAST:
+    case Lara::STATE_WADE: case Lara::STATE_UW_TREAD: case Lara::STATE_UW_SWIM:
+    case Lara::STATE_UW_DIVE: case Lara::STATE_UW_GLIDE:
+    case Lara::STATE_SURF_TREAD: case Lara::STATE_SURF_SWIM: case Lara::STATE_SURF_BACK:
+    case Lara::STATE_SURF_LEFT: case Lara::STATE_SURF_RIGHT: {
+        CoopPose &saved=gCoopPose[lara==players[1]];
+        const vec3i p=lara->pos;
+        if (saved.at.room==lara->room && saved.water==lara->waterState &&
+            saved.at.pos.x==p.x && saved.at.pos.y==p.y && saved.at.pos.z==p.z) {
+            saved.yaw=lara->angle.y;
+            break;
+        }
+        const CoopPose pose={{lara->room,p},lara->angle.y,lara->waterState};
+        if (coopPoseUsable(pose))saved=pose;
+        break;
+    }
+    }
+}
