+// Repaired omission (tr64 hunk 16): item.h never constructed a controller for ITEM_DRAWBRIDGE,
+// so the bridge stayed in state 0 (frame 0) however it was triggered. Behaviour from the
+// floating-point game's Drawbridge (OpenLara src/objects.h:842-858, 2333adef) and
+// docs/specs/wall/drawbridge.md: the trigger drives its animation (goal down while active, up
+// otherwise, every frame); getItemFloorCeiling already gives the floor/ceiling while its current
+// state is down; while the current state is up it is a solid object.
+struct DrawBridge : Object
+{
+    enum {
+        STATE_UP,
+        STATE_DOWN
+    };
+
+    DrawBridge(Room* room) : Object(room) {}
+
+    virtual void update()
+    {
+        if (isActive()) {
+            if (state == STATE_UP) {
+                goalState = STATE_DOWN;
+            }
+        } else {
+            if (state == STATE_DOWN) {
+                goalState = STATE_UP;
+            }
+        }
+
+        animProcess();
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        // Raised: a solid like a closed door; the push-out also hits Lara while it is moving
+        // (state != goalState). Lowered: nothing, the bridge is a floor.
+        if (state != STATE_UP)
+            return;
+
+        if (!updateHitMask(lara, cinfo))
+            return;
+
+        if (!cinfo->enemyPush)
+            return;
+
+        collidePush(lara, cinfo, state != goalState);
+    }
+};
+
+
+// Repaired omission (tr64 hunk 19): item.h never constructed a controller for ITEM_CABIN (LEVEL10A
+// item 84, Natla's Mines), so the three fuses did nothing. OpenLara src/objects.h:1463-1490
+// (2333adef) and docs/specs/wall/objects-missing.md section 18: each completed trigger mask
+// advances it one stage (states 0, 1, 2 -> goal state + 1) and clears the code bits; in state 4
+// map flip slot 3 is set to all code bits, the map is flipped and the item is removed.
+// It is a solid object.
+struct Cabin : Object
+{
+    enum {
+        STATE_UP,
+        STATE_DOWN_1,
+        STATE_DOWN_2,
+        STATE_DOWN_3,
+        STATE_GROUND
+    };
+
+    Cabin(Room* room) : Object(room) {}
+
+    virtual void update()
+    {
+        if ((flags & ITEM_FLAG_MASK) == ITEM_FLAG_MASK)
+        {
+            if (state >= STATE_UP && state <= STATE_DOWN_2)
+                goalState = state + 1;
+            flags &= ~ITEM_FLAG_MASK;
+        }
+
+        if (state == STATE_GROUND)
+        {
+            gFlipMapState[3].mask = ITEM_FLAGS_MASK_ALL;
+            gFlipMapState[3].flags |= FLIPMAP_ACTIVE;
+            worldRequestFlipToggle();
+            worldApplyPendingFlip();
+            flags &= ~(ITEM_FLAG_STATUS | ITEM_FLAG_COLLISION);
+            flags |= ITEM_FLAG_STATUS_INVISIBLE;
+            deactivate();
+            return;
+        }
+
+        animProcess();
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        collideDefault(lara, cinfo);
+    }
+};
