+// tr64 oracle: the lava floor rule (docs/specs/wall/objects-missing.md 15.3, triggers-and-effects.md 2.1).
+// Nothing happens if Lara's hit points are already below 0, if she is not on the floor (y equals her recorded
+// floor), or if the real floor of the sector (read at y = 32000: the lowest, ignoring bridges and other items)
+// is not her recorded floor. Otherwise her hit points become -1 and she burns (the flames attached to her
+// are the burning state; the death proceeds as for any hit points of 0 or below).
+void hazardLavaBurn(ItemObj *item)
+{
+    if (!item || item->type != ITEM_LARA)
+        return;
+    Lara *lara = (Lara*)item;
+    const int32 playerIndex = hazardLaraPlayerIndex(lara);
+    if (playerIndex < 0 || lara->health < 0 || lara->pos.y != lara->roomFloor)
+        return;
+
+    const FloorData *lastData = gLastFloorData;
+    const int32 lastSlant = gLastFloorSlant;
+    const int32 realFloor = lara->room->getSector(lara->pos.x, lara->pos.z)->getFloor(lara->pos.x, 32000, lara->pos.z);
+    gLastFloorData = lastData;
+    gLastFloorSlant = lastSlant;
+    if (realFloor != lara->roomFloor)
+        return;
+
+    lara->health = -1;
+    lara->extraL->hazardCause = uint8(HAZARD_HIT_LAVA);
+    LaraHazardState &state = gLaraHazardState[playerIndex];
+    state.burnTicks = HazardOracleFlame::BURN_DURATION_TICKS;
+    state.damageCooldown = 0;
+    state.flameItemIndex = -1;
+    state.flags = LARA_HAZARD_BURNING;
+    state.reserved = 0;
