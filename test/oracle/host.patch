+// Repaired omission (tr64 hunk 25): item.h never constructed a controller for ITEM_MOVING_BLOCK
+// (the rolling block, LEVEL3B items 49 and 50), so its sectors were never solid and it never
+// slid. docs/specs/wall/objects-missing.md sections 2.1 and 3, floating-point game
+// OpenLara src/objects.h:613-669 (2333adef). Its sector is raised by 2048 (8 clicks) from the
+// start (worldRebuildDerivedState does this for every block, as for the pushable ones); while
+// triggered in state 0 the goal is 1, while not triggered in state 1 the goal is 0, and the
+// sector is restored when the slide begins; the slide animation ends with the kill command
+// (status inactive), then the block stays in the active list, snaps to the centre of its
+// sector and raises it there. It evaluates no heavy trigger (specification, differs from the
+// floating-point game).
+#define MOVING_BLOCK_CLICKS 8
+
+static void movingBlockAdjust(Room* room, const vec3i &pos, Sector &sector, bool raise)
+{
+    // Specification 2.1: raise by D: C = ceiling value of the sector found at y - D - 1024; a wall
+    // gets C - D, else the floor value drops by D and becomes a wall on reaching C. Restore by D:
+    // C at y + D - 1024; a wall gets C + D, else the floor value rises by D.
+    const int32 D = MOVING_BLOCK_CLICKS << 8;
+    Room* other = room->getRoom(pos.x, raise ? pos.y - D - 1024 : pos.y + D - 1024, pos.z);
+    const int32 c = other->getSector(pos.x, pos.z)->ceiling;
+    const int32 step = raise ? -MOVING_BLOCK_CLICKS : MOVING_BLOCK_CLICKS;
+    if (sector.floor == NO_FLOOR) {
+        sector.floor = int8(c + step);
+    } else {
+        sector.floor = int8(sector.floor + step);
+        if (sector.floor == c)
+            sector.floor = NO_FLOOR;
+    }
+}
+
+static void movingBlockFloor(Room* room, const vec3i &pos, bool raise)
+{
+    Room* target = room->getRoom(pos.x, pos.y, pos.z);
+    if (!target->modify()) {
+        ASSERT(false);
+        return;
+    }
+    movingBlockAdjust(target, pos, *(Sector*)target->getSector(pos.x, pos.z), raise);
+}
+
+struct MovingBlock : Object
+{
+    enum {
+        STATE_START,
+        STATE_END,
+        STATE_MOVE
+    };
+
+    MovingBlock(Room* room) : Object(room) {}
+
+    virtual void update()
+    {
+        if (isActive())
+        {
+            if (state == STATE_START)
+            {
+                goalState = STATE_END;
+                movingBlockFloor(room, pos, false);
+            }
+        }
+        else if (state == STATE_END)
+        {
+            goalState = STATE_START;
+            movingBlockFloor(room, pos, false);
+        }
+
+        animProcess();
+
+        if ((flags & ITEM_FLAG_STATUS) == ITEM_FLAG_STATUS_INACTIVE)
+        {
+            flags &= ~ITEM_FLAG_STATUS;
+            flags |= ITEM_FLAG_STATUS_ACTIVE; // stays in the active list
+            pos.x = (pos.x & ~1023) + 512;
+            pos.z = (pos.z & ~1023) + 512;
+            movingBlockFloor(room, pos, true);
+        }
+    }
+};
+
