+// Repaired omission (tr64 hunk 26): item.h never constructed a controller for ITEM_MOVING_OBJECT
+// (the moving bar: LEVEL4 items 75 to 78, LEVEL10A item 12). Specification section 6 and
+// OpenLara src/objects.h:1406-1425 (2333adef): while active the goal state is 1 while triggered
+// and 0 otherwise, the item follows its animation (its speed moves it along its facing) and its
+// room follows its position; it is a standard solid.
+struct MovingBar : Object
+{
+    enum {
+        STATE_CLOSE,
+        STATE_OPEN
+    };
+
+    MovingBar(Room* room) : Object(room) {}
+
+    virtual void update()
+    {
+        goalState = isActive() ? STATE_OPEN : STATE_CLOSE;
+        animProcess();
+
+        Room* nextRoom = room->getRoom(pos.x, pos.y, pos.z);
+        if (room != nextRoom)
+        {
+            room->remove(this);
+            nextRoom->add(this);
+        }
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        collideDefault(lara, cinfo);
+    }
+};
