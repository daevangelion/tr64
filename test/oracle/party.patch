+static void coopClearInteraction(Lara* lara)
+{
+    gCoopInteraction[lara==players[1]]=NULL;
+    FlowState &flow=gFlowState[lara==players[1]];
+    flow.cameraIndex=-1;
+    flow.active=0;
+    if (inventory.lara==lara)
+        inventory.useSlot=SLOT_MAX;
+}
+
+static bool coopJoin()
+{
+    if (!players[0] || players[1] || isCutsceneLevel() ||
+        inventory.state!=INV_STATE_NONE || !ItemObj::sFirstFree)
+        return false;
+    Lara *lead=players[0];
+    players[1]=(Lara*)ItemObj::sFirstFree;
+    ItemObj *item=ItemObj::sFirstFree;
+    ItemObj *next=item->nextItem;
+    item->resetSlot();
+    item->nextItem=next;
+    ItemObj::add(ITEM_LARA,lead->room,lead->pos,lead->angle.y);
+    for (int i=0;i<MAX_ENEMIES;++i)
+        if (enemiesExtra[i].enemy) {
+            enemiesExtra[i].contact[0]=enemiesExtra[i].enemy->hitMask;
+            enemiesExtra[i].contact[1]=0;
+        }
+    return true;
+}
+
+static bool coopLeave()
+{
+    Lara *lara=players[1];
+    if (!lara)return false;
+    coopClearInteraction(lara);
+    hazardClearLaraBurn(lara);
+    if (inventory.lara==lara)inventory.lara=players[0];
+    if (gEffectState.lara==lara)gEffectState.lara=NULL;
+    if (tinfo.target==lara)tinfo.target=players[0];
+    for (int i=0;i<MAX_ENEMIES;++i) {
+        ExtraInfoEnemy &e=enemiesExtra[i];
+        if (!e.enemy)continue;
+        if (e.target==lara)e.target=NULL;
+        e.enemy->hitMask=e.contact[0];
+        e.contact[0]=e.contact[1]=0;
+    }
+    Camera &camera=playersExtra[0].camera;
+    if (camera.lookAtItem==lara)camera.lookAtItem=NULL;
+    if (camera.lastItem==lara)camera.lastItem=NULL;
+    lara->remove();
+    players[1]=NULL;
+    playersExtra[1].camera=Camera();
+    gCoopCollisionOffset=_vec3i(0,0,0);
+    return true;
+}
+
+// 0: moved, 1: no living partner, 2: reviving requires a large medipack.
+static int coopWarp(unsigned slot)
+{
+    if (slot>=MAX_PLAYERS || !players[0] || isCutsceneLevel())
+        return 1;
+    Lara *lara=players[slot], *lead=players[slot^1];
+    if (!lara || !lead || lead->health<=0)return 1;
+    if (lara->health<=0) {
+        if (!inventory.consumeCount(SLOT_MEDIKIT_BIG,1))return 2;
+        gSaveGame.mediUsed+=2;
+    }
+    coopClearInteraction(lara);
+    hazardClearLaraBurn(lara);
+    for (ItemObj *item=ItemObj::sFirstActive;item;) {
+        ItemObj *next=item->nextActive;
+        if (item->type==ITEM_MUZZLE_FLASH && item->extra==(uint8*)lara)item->remove();
+        item=next;
+    }
+    for (int i=0;i<MAX_ENEMIES;++i)enemiesExtra[i].contact[slot]=0;
+    lara->room->remove(lara);
+    lara->resetSlot();
+    lara->type=ITEM_LARA;
+    lara->pos=lead->pos;
+    lara->angle.y=lead->angle.y;
+    lara->intensity=128;
+    lara->init(lead->room);
+    if (slot)gCoopCollisionOffset=_vec3i(0,0,0);
+    else cinfo.offset=_vec3i(0,0,0);
+    return 0;
+}
