+uint64_t coopDistanceSquared(const vec3i &a,const vec3i &b)
+{
+    vec3i d=a-b;
+    return uint64_t(int64_t(d.x)*d.x)+uint64_t(int64_t(d.y)*d.y)+uint64_t(int64_t(d.z)*d.z);
