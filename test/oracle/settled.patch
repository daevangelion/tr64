+void checkTrigger(const FloorData* fd,ItemObj* lara)
+{
+    checkTriggerInternal(fd,lara,-1);
+}
+
+static uint16 coopTicksToFreeHands(const CoopKeyAnim &key)
+{
+    ItemObj cursor;
+    cursor.animIndex=key.anim;
+    cursor.frameIndex=key.frame;
+    cursor.state=key.state;
+    cursor.goalState=key.goal;
+    const Anim* anim=level.anims+cursor.animIndex;
+    for (uint16 tick=1;tick<4096;++tick) {
+        ++cursor.frameIndex;
+        anim=cursor.animChange(anim);
+        const bool end=cursor.frameIndex>anim->frameEnd;
+        for (unsigned pass=0;pass<1u+unsigned(end);++pass) {
+            if (pass) {
+                cursor.frameIndex=anim->nextFrameIndex;
+                cursor.animIndex=anim->nextAnimIndex;
+                anim=level.anims+cursor.animIndex;
+                cursor.state=anim->state;
+            }
+            const int16* p=level.animCommands+anim->commandsStart;
+            for (unsigned i=0;i<anim->commandsCount;++i) {
+                switch (*p++) {
+                case ANIM_CMD_OFFSET: p+=3; break;
+                case ANIM_CMD_JUMP: case ANIM_CMD_SOUND: p+=2; break;
+                case ANIM_CMD_EMPTY: if (end && !pass)return tick; break;
+                case ANIM_CMD_EFFECT:
+                    if ((!end || pass) && cursor.frameIndex==p[0] && p[1]==FX_LARA_HANDSFREE)return tick;
+                    p+=2;
+                    break;
+                }
+            }
+        }
+    }
+    ASSERT(false);
+    return 1;
+}
+
+static const FloorData* coopLinkedTrigger(Room* room,const vec3i &pos,unsigned type,unsigned item)
+{
+    const FloorData* scratch=gLastFloorData;
+    const uint16 slant=gLastFloorSlant;
+    room->getSector(pos.x,pos.z)->getFloor(pos.x,pos.y,pos.z);
+    const FloorData* fd=gLastFloorData;
+    gLastFloorData=scratch;
+    gLastFloorSlant=slant;
+    if (fd && FD_FLOOR_TYPE(*fd)==FLOOR_TYPE_LAVA) {
+        if (FD_END(*fd))return NULL;
+        ++fd;
+    }
+    return fd && unsigned(FD_TRIGGER_TYPE(fd[0]))==type && unsigned(FD_ARGS(fd[2]))==item ? fd : NULL;
+}
+
+static const FloorData *coopFindLinkedTrigger(vec3i pos,unsigned type,unsigned item)
+{
+    const FloorData *best=NULL;
+    uint64_t distance=UINT64_MAX;
+    for (unsigned r=0;r<level.roomsCount;++r) {
+        const Room *room=rooms+r;
+        const RoomInfo *info=room->info;
+        unsigned nx=info->xSectors,nz=info->zSectors;
+        for (unsigned i=0;i<nx*nz;++i) {
+            unsigned offset=room->sectors[i].floorIndex;
+            if (!offset)continue;
+            const FloorData *fd=level.floors+offset;
+            for (;;) {
+                uint16 cmd=*fd;
+                unsigned kind=cmd&31;
+                if (kind==FLOOR_TYPE_TRIGGER) {
+                    if (FD_TRIGGER_TYPE(cmd)==type && unsigned(FD_ARGS(fd[2]))==item) {
+                        int64_t dx=(int64_t)(info->x*256)+(i/nz)*1024+512-pos.x;
+                        int64_t dz=(int64_t)(info->z*256)+(i%nz)*1024+512-pos.z;
+                        uint64_t d=(uint64_t)(dx*dx)+(uint64_t)(dz*dz);
+                        if (d<distance) { best=fd; distance=d; }
+                    }
+                    break;
+                }
+                if (FD_END(cmd))break;
+                if (kind==FLOOR_TYPE_LAVA)++fd;
+                else if (kind==FLOOR_TYPE_PORTAL || kind==FLOOR_TYPE_FLOOR || kind==FLOOR_TYPE_CEILING)fd+=2;
+                else break;
+            }
+        }
+    }
+    return best;
+}
+
+void coopRetireInteraction(ItemObj* owner,ItemObj* item,unsigned slot)
+{
+    const unsigned type=item->type,status=item->flags&ITEM_FLAG_STATUS,index=item-items;
+    unsigned trigger,wait=0;
+    if ((type==ITEM_SCION_PICKUP_HOLDER && gLevelID==LVL_TR1_10B) ||
+        (type==ITEM_SCION_PICKUP_QUALOPEC && gLevelID==LVL_TR1_8C &&
+         (status==ITEM_FLAG_STATUS_INVISIBLE || status==ITEM_FLAG_STATUS_INACTIVE)))
+        gCoopRetireLevel=true;
+    if ((type==ITEM_SWITCH || type==ITEM_SWITCH_WATER) &&
+        (status==ITEM_FLAG_STATUS_ACTIVE || status==ITEM_FLAG_STATUS_INACTIVE))
+        trigger=TRIGGER_TYPE_SWITCH;
+    else if (status==ITEM_FLAG_STATUS_ACTIVE &&
+             ((type>=ITEM_KEYHOLE_1 && type<=ITEM_KEYHOLE_4) ||
+              (type>=ITEM_PUZZLEHOLE_1 && type<=ITEM_PUZZLEHOLE_DONE_4))) {
+        trigger=TRIGGER_TYPE_KEY;
+        wait=owner->health>0 && owner->extraL->weaponState==WEAPON_STATE_FREE ? 1 :
+            coopTicksToFreeHands(gCoopKeyAnim[slot]);
+        if (type<=ITEM_PUZZLEHOLE_4 && type>=ITEM_PUZZLEHOLE_1)
+            item->type+=ITEM_PUZZLEHOLE_DONE_1-ITEM_PUZZLEHOLE_1;
+    } else if (status==ITEM_FLAG_STATUS_INVISIBLE)
+        trigger=TRIGGER_TYPE_PICKUP;
+    else return;
+    const FloorData* fd=coopLinkedTrigger(owner->room,owner->pos,trigger,index);
+    if (!fd && item->room)fd=coopLinkedTrigger(item->room,item->pos,trigger,index);
+    if (!fd && trigger!=TRIGGER_TYPE_PICKUP)fd=coopFindLinkedTrigger(owner->pos,trigger,index);
+    if (fd && !gCoopRetired[index].trigger) {
+        gCoopRetired[index]={fd,uint16(wait),uint8(slot)};
+        ++gCoopRetiredCount;
+    }
+}
+
+void coopSettleInteractions()
+{
+    for (unsigned i=0;i<level.itemsCount && gCoopRetiredCount;++i) {
+        CoopRetiredAction &p=gCoopRetired[i];
+        if (!p.trigger || (p.ticks && --p.ticks))continue;
+        if (FD_TRIGGER_TYPE(p.trigger[0])==TRIGGER_TYPE_SWITCH &&
+            (items[i].flags&ITEM_FLAG_STATUS)!=ITEM_FLAG_STATUS_INACTIVE)continue;
+        const CoopRetiredAction action=p;
+        p=CoopRetiredAction();
+        --gCoopRetiredCount;
+        checkTriggerInternal(action.trigger,NULL,action.slot);
+    }
+}
