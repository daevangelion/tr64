+
+enum { INTERACTION_LIMIT=4096 };
+
+static bool switchType(unsigned type)
+{
+    return type==ITEM_SWITCH || type==ITEM_SWITCH_WATER;
+}
+static bool keyType(unsigned type)
+{
+    return (type>=ITEM_KEYHOLE_1 && type<=ITEM_KEYHOLE_4) ||
+           (type>=ITEM_PUZZLEHOLE_1 && type<=ITEM_PUZZLEHOLE_DONE_4);
+}
+static bool movingBlock(const ItemObj *item)
+{
+    if (item->type<ITEM_BLOCK_1 || item->type>ITEM_BLOCK_4)return false;
+    unsigned i=(unsigned)(item-items);
+    return (gCoopBlocks[i/32]&(1u<<(i%32)))!=0;
+}
+static bool owedScion(const ItemObj *item)
+{
+    unsigned status=item->flags&ITEM_FLAG_STATUS;
+    return (item->type==ITEM_SCION_PICKUP_HOLDER && gLevelID==LVL_TR1_10B) ||
+        (item->type==ITEM_SCION_PICKUP_QUALOPEC && gLevelID==LVL_TR1_8C &&
+         (status==ITEM_FLAG_STATUS_INVISIBLE || status==ITEM_FLAG_STATUS_INACTIVE));
+}
+bool coopInteractionBusy(const Lara *actor)
+{
+    unsigned slot=(actor==players[1]);
+    if (gCoopRetired[slot].actor)return true;
+    const ItemObj *item=gCoopInteraction[slot];
+    if (!item)return false;
+    unsigned status=item->flags&ITEM_FLAG_STATUS;
+    if (owedScion(item) || movingBlock(item))return true;
+    if (switchType(item->type))return status==ITEM_FLAG_STATUS_ACTIVE || status==ITEM_FLAG_STATUS_INACTIVE;
+    if (keyType(item->type))return status==ITEM_FLAG_STATUS_ACTIVE;
+    return (actor->health>0 && item->type==ITEM_MIDAS_HAND && actor->state==Lara::STATE_USE_MIDAS) ||
+        (actor->state==Lara::STATE_PICKUP &&
+         (status==ITEM_FLAG_STATUS_INVISIBLE || (actor->health>0 && status==ITEM_FLAG_STATUS_INACTIVE)));
+}
+bool coopSaveBlocked(void)
+{
+    if (gCoopRetireLevel)return 1;
+    for (unsigned slot=0;slot<MAX_PLAYERS;++slot)
+        if (gCoopRetired[slot].actor || (players[1] && players[slot]->health<=0 &&
+                                       coopInteractionBusy(players[slot])))return 1;
+    return 0;
+}
+void coopInteractionTriggered(ItemObj *item)
+{
+    for (unsigned slot=0;slot<MAX_PLAYERS;++slot)
+        if (gCoopInteraction[slot]==item)gCoopInteraction[slot]=NULL;
+}
+void coopInteractionCompletedLevel(ItemObj* actor)
+{
+    unsigned slot=(actor==players[1]);
+    ItemObj* item=gCoopInteraction[slot];
+    if (item && owedScion(item))gCoopInteraction[slot]=NULL;
+}
+void coopRetireInteraction(Lara *actor)
+{
+    unsigned slot=(actor==players[1]);
+    ItemObj *item=gCoopInteraction[slot];
+    CoopRetiredAction *owed=&gCoopRetired[slot];
+    if (!item || owed->actor)return;
+    if (!coopInteractionBusy(actor)) {
+        gCoopInteraction[slot]=NULL;
+        return;
+    }
+    owed->actor=actor;
+    if (owedScion(item)) {
+        gCoopRetireLevel=true;
+        owed->ticks=coopTicksToInteractionEvent(gCoopKeyAnim[slot],true);
+    } else if (keyType(item->type)) {
+        owed->ticks=coopTicksToInteractionEvent(gCoopKeyAnim[slot],false);
+    }
+    else if (actor->state==Lara::STATE_PICKUP)owed->ticks=1;
+    else owed->ticks=INTERACTION_LIMIT;
+}
+
+bool coopSettleInteraction(Lara *actor)
+{
+    unsigned slot=(actor==players[1]);
+    CoopRetiredAction *owed=&gCoopRetired[slot];
+    if (!owed->actor)return false;
+    actor=owed->actor;
+    ItemObj *item=gCoopInteraction[slot];
+    if (!item) {
+        *owed=CoopRetiredAction();
+        return false;
+    }
+    if (owedScion(item)) {
+        if (owed->ticks)--owed->ticks;
+        return true;
+    }
+    if (owed->ticks)--owed->ticks;
+    unsigned type=item->type, status=item->flags&ITEM_FLAG_STATUS, trigger;
+    if (switchType(type)) {
+        if (status==ITEM_FLAG_STATUS_ACTIVE && owed->ticks)return true;
+        trigger=TRIGGER_TYPE_SWITCH;
+    } else if (keyType(type)) {
+        if (owed->ticks)return true;
+        trigger=TRIGGER_TYPE_KEY;
+        if (type>=ITEM_PUZZLEHOLE_1 && type<=ITEM_PUZZLEHOLE_4)
+            item->type+=ITEM_PUZZLEHOLE_DONE_1-ITEM_PUZZLEHOLE_1;
+    } else if (status==ITEM_FLAG_STATUS_INVISIBLE && actor->state==Lara::STATE_PICKUP) {
+        trigger=TRIGGER_TYPE_PICKUP;
+    } else {
+        if (movingBlock(item) && owed->ticks)return true;
+        *owed=CoopRetiredAction();
+        gCoopInteraction[slot]=NULL;
+        return false;
+    }
+    /* The corpse never moved to another sector. Read this actor's actual
+     * floor and keep the normal interpreter (including local cameras). */
+    const vec3i p=actor->pos;
+    const FloorData *saved=gLastFloorData;
+    uint16 slant=gLastFloorSlant;
+    actor->room->getSector(p.x,p.z)->getFloor(p.x,p.y,p.z);
+    const FloorData *fd=gLastFloorData, *cmd=fd;
+    gLastFloorData=saved;
+    gLastFloorSlant=slant;
+    *owed=CoopRetiredAction();
+    gCoopInteraction[slot]=NULL;
+    if (cmd && (*cmd&31)==FLOOR_TYPE_LAVA)
+        cmd=(*cmd&0x8000) ? NULL : cmd+1;
+    if (cmd && FD_TRIGGER_TYPE(cmd[0])==trigger &&
+        FD_ARGS(cmd[2])==(unsigned)(item-items)) {
+        uint8 hands=actor->extraL->weaponState;
+        if (trigger==TRIGGER_TYPE_KEY)actor->extraL->weaponState=WEAPON_STATE_FREE;
+        checkTrigger(fd,actor);
+        actor->extraL->weaponState=hands;
+    }
+    return true; /* Render the authored camera on this tick before death animation. */
 }
 
