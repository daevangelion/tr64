# SPDX-License-Identifier: MIT
# Original LEVEL1 room36 sector6 has a secret action in its source floor stream.
# Centre/floor coordinates are derived from that sector, not an injected cue.
scene music-level1-secret
start boot
load level level1
game
place 36 89600 1024 37376 -32768
ticks 210
seed 1
observe log "^music: starts=3 loops=0 unavailable=0 underruns=0 .*current=5 phase=5$"
observe pools
observe placement
