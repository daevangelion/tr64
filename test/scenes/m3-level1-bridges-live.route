# Placed on the original wolf-activation tile; walk/drop into room14 and fire.
scene m3-level1-bridges-live
start boot
load level level1
game
place 13 31232 4352 48640 -8192
ticks 180
seed 1
at 0 pad 256 0 0
at 1 pad 8 0 0
at 80 pad 136 0 0
observe log "(?s)(?=.*game-render: .* entities=[1-9][0-9]* )(?=.*render-phases: view_us=[0-9]+ pulls=[1-9][0-9]* )"
observe pools
observe placement
