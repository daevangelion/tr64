diff --git a/ares/n64/dd/rtc.cpp b/ares/n64/dd/rtc.cpp
index 494c1f46e..81c2df2bc 100644
--- a/ares/n64/dd/rtc.cpp
+++ b/ares/n64/dd/rtc.cpp
@@ -7,11 +7,31 @@ auto DD::RTC::load() -> void {
   //byte 0 to 7 = raw rtc time (last updated, only 6 bytes are used)
   n64 check = 0;
   for(auto n : range(8)) check.byte(n) = ram.read<Byte>(n);
-  if(!~check) return;  //new save file
 
-  //check for invalid time info, if invalid, set time info to something invalid and ignore the rest
-  if (!valid()) {
-    for(auto n : range(8)) ram.write<Byte>(n, 0xff);
+  // New or invalid RTC (all 0xFF / non-BCD): seed a valid host time.
+  // Retail DDIPL polls GetRTC* forever while the clock reads 0xFFFF and never
+  // proceeds to disk Start/ReadSeek — so an uninitialized RTC blocks boot.
+  if(!~check || !valid()) {
+    time_t t = time(0);
+    auto* tm = localtime(&t);
+    auto bcd = [](u32 n) -> u8 { return (u8)(((n / 10) << 4) | (n % 10)); };
+    // BCD layout: year, month, day, hour, minute, second (see valid()/tickSecond)
+    u32 year = tm ? (u32)(tm->tm_year % 100) : 99;  // 0-99 BCD year
+    u32 mon  = tm ? (u32)(tm->tm_mon + 1) : 1;
+    u32 day  = tm ? (u32)tm->tm_mday : 1;
+    u32 hour = tm ? (u32)tm->tm_hour : 0;
+    u32 min  = tm ? (u32)tm->tm_min : 0;
+    u32 sec  = tm ? (u32)tm->tm_sec : 0;
+    ram.write<Byte>(0, bcd(year));
+    ram.write<Byte>(1, bcd(mon));
+    ram.write<Byte>(2, bcd(day));
+    ram.write<Byte>(3, bcd(hour));
+    ram.write<Byte>(4, bcd(min));
+    ram.write<Byte>(5, bcd(sec));
+    ram.write<Byte>(6, 0);
+    ram.write<Byte>(7, 0);
+    n64 now = (n64)t;
+    for(auto n : range(8)) ram.write<Byte>(8 + n, now.byte(n));
     return;
   }
 
