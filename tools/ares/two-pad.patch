@@ -170,11 +181,37 @@
       over = status.bit(1);
     }
 
+    // Only a full gamepad poll can consume a numbered test input.
+    unsigned long long entry = 0;
+    if(valid && channel < 2 && send == 1 && recv == 4 && input[0] == 1 &&
+       controllers[channel]->device->node->name() == "Gamepad" && inject[channel]) {
