 // image when the guest exits through this device (the exit does not run the emulator's
 // own save, which only autosaves every 30 s and at unload).
 //
+// SRAM fixtures are opt-in only: ARES_SRAM_IN imports canonical guest-order
+// bytes before boot; ARES_SRAM_OUT exports them at this test-only exit.
+// Without either variable, normal SRAM loading/saving behavior is unchanged.
+//
 // Register map (32-bit CPU accesses):
 //   +0x00  CMD   (w): 1 = screenshot, 2 = exit
 //   +0x04  ARG0  (w): screenshot: RDRAM byte address of framebuffer
@@ -25,10 +29,28 @@
 //   +0x10  MAGIC (r): 0x54455354 "TEST" — presence probe for the guest
 
 #include <n64/agent.hpp>
+#include <signal.h>
 
 // Final VI dump lives in cpu/debugger.cpp (HostShot); linked via unity TU order.
 auto agentDumpFinalShot() -> void;
 
+// A shipping cart never calls the guest exit, so ARES_SRAM_OUT is also written
+// when the harness terminates the emulator (TERM/INT), then the process leaves
+// without the emulator's own unload.
+static void exportSramOnSignal(int signalNumber) {
+  const char* path = getenv("ARES_SRAM_OUT");
+  FILE* fp = path && cartridge.ram.size ? fopen(path, "wb") : nullptr;
+  bool ok = fp != nullptr;
+  for(u32 address = 0; ok && address < cartridge.ram.size; ++address) {
+    if(fputc(cartridge.ram.read<Byte>(address), fp) == EOF) ok = false;
+  }
+  if(fp && fclose(fp)) ok = false;
+  printf("TESTHARNESS SRAM %s %s (%u bytes) on signal %d\n", ok ? "out" : "out FAILED",
+    path ? path : "(unset)", (u32)cartridge.ram.size, signalNumber);
+  fflush(stdout);
+  ::_Exit(ok ? 128 + signalNumber : 2);
+}
